PORT=3000
JWT_SECRET=ganti_dengan_jwt_secret_acak_yang_panjang_dan_aman_di_sini
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173
DB_PATH=./data/app.db

# Aturan Presensi
ZONA_WAKTU=Asia/Jakarta
TOLERANSI_TERLAMBAT_MENIT=15
PRESENSI_BUKA_SEBELUM_MENIT=15
MAX_AKURASI_METER=100
TANGGAL_MULAI_SEMESTER=2026-08-24

# Konfigurasi Biometrik & Upload Foto Wajah (Tahap 4)
UPLOAD_DIR=./uploads
MAX_FOTO_MB=2
JUMLAH_SAMPLE_WAJAH=3
WAJIB_DAFTAR_WAJAH=true
FACE_THRESHOLD=0.8

# Flag Development (Hanya berlaku jika NODE_ENV !== "production")
NODE_ENV=development
DEV_IZINKAN_PRESENSI_ULANG=true
DEV_SESI_SELALU_BUKA=true
